# Copia este archivo a .env y complétalo con TUS valores.
# NUNCA subas el .env real al repositorio (ya está en .gitignore).
# El programa lee estas variables de entorno; si faltan, simplemente
# no envía esa alerta (la corrida igual guarda el histórico).

# --- Alerta por email (SMTP) ---
# Ejemplo con un proveedor cualquiera; usa contraseña de aplicación, no la real.
SMTP_HOST=smtp.tu-proveedor.com
SMTP_PORT=587
SMTP_USER=tu-usuario
SMTP_PASS=tu-contraseña-de-aplicacion
ALERT_EMAIL_FROM=alertas@tudominio.com
ALERT_EMAIL_TO=tu-correo@ejemplo.com

# --- Alerta por webhook genérico (POST JSON {title, message}) ---
# Sirve para Slack/Discord/Make/n8n/Zapier, etc.
# WEBHOOK_URL=https://ejemplo.com/webhook/xxxx

# --- Alerta por ntfy (notificación push al celular) ---
# Define SOLO el nombre del topic (no uses uno real en el repo).
# NTFY_SERVER=https://ntfy.sh
# NTFY_TOPIC=mi-topic-privado-aqui
